# ============================================================
# Party · claves de los proveedores de IA
# 1) Copia este archivo como  .env   (sin el ".example")
# 2) Pega cada clave después del "=" (sin comillas ni espacios)
# 3) NUNCA subas el archivo .env a GitHub (ya está en .gitignore)
# ============================================================

# Groq       → https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini → https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Mistral    → https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# OpenRouter → https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Opcional ---
# Puerto del servidor del agente
PARTY_AGENT_PORT=8787
